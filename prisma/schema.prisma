// Ridgewood School, Mirganj — Prisma schema (MongoDB)
// Parents, Students, Report Cards, Notices, Participation, Gallery Items

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Parent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  phone        String   @unique
  passwordHash String
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students     Student[]
  notices      NoticeRead[]
}

model Student {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  rollNo       String
  classSection String
  classTeacher String
  parentName   String
  parentId     String   @db.ObjectId
  parent       Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  attendance   Int      @default(95)
  averageGrade String   @default("A")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportCards     ReportCard[]
  participation   Participation[]
}

model ReportCard {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String   @db.ObjectId
  term        String
  remarks     String?
  pdfUrl      String?
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjects    Subject[]
}

model Subject {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  reportCardId String  @db.ObjectId
  name        String
  marks       Int
  grade       String
  reportCard  ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
}

model Notice {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  body        String
  tag         String   @default("General")
  date        String
  createdAt   DateTime @default(now())

  readBy      NoticeRead[]
}

model NoticeRead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  noticeId    String   @db.ObjectId
  parentId    String   @db.ObjectId
  readAt      DateTime @default(now())
  notice      Notice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  parent      Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model Participation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String   @db.ObjectId
  event       String
  date        String
  result      String
  category    String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model GalleryItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  imageUrl    String
  thumbnailUrl String?
  publicId    String?
  type        String   @default("photo")
  tag         String   @default("General")
  date        String?
  isPublic    Boolean  @default(true)
  studentId   String?
  uploadedBy  String?
  createdAt   DateTime @default(now())
}
